# ==============================================================================
# Obsidian Plugin Backend Configuration
# File: server/data/config/.env
# Note: Copy this file to server/data/config/.env and fill in your actual credentials.
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=5125
ENVIRONMENT=production

# Security & Authentication
# Shared secret token for Authorization: Bearer <TOKEN> and X-Auth-Token header
AUTH_TOKEN=your_secure_bearer_token_here

# AI Model Credentials (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Audio Transcription (Whisper)
# Options: cloud_gemini | cloud_openai | local_faster_whisper
TRANSCRIPTION_ENGINE=cloud_gemini
OPENAI_API_KEY=your_openai_api_key_if_using_whisper

# Storage Directories (Absolute paths inside Docker or relative to backend root)
VAULT_PATH=/data/vault
ARCHIVE_PATH=/data/archive
CONFLICTS_PATH=/data/conflicts
DB_PATH=/data/sync_manifest.db
TEMP_DIR=/data/temp
